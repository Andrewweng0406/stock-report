# 必填：OpenAI Platform 建立的 API Key
OPENAI_API_KEY=sk-...

# 預設使用目前的旗艦推理模型；若帳號改用其他版本，可自行替換 ID
# （例如 gpt-5.6-terra / gpt-5.6-luna 為更省成本的版本）。
OPENAI_MODEL=gpt-5.6

# Telegram 推播（不使用推播時可留空）
TELEGRAM_BOT_TOKEN=123456789:replace_me
TELEGRAM_CHAT_ID=@your_channel_or_chat_id

# Telegram 訊息中的儀表板連結；只在本機瀏覽可用 localhost，
# 需要手機等其他裝置連線時請改成主機的區網 IP，例如 http://192.168.1.10:8501
APP_URL=http://localhost:8501

# 預設值為 sqlite:///earnings_reports.db
DATABASE_URL=sqlite:///earnings_reports.db

# monitor.py 用：SEC EDGAR 要求請求標頭附上可辨識身份的聯絡信箱
SEC_CONTACT_EMAIL=you@example.com

# monitor.py 輪詢 SEC EDGAR 的間隔秒數，預設 900 秒（15 分鐘）
MONITOR_POLL_SECONDS=900
